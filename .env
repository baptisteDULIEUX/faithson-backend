# Port du serveur
PORT=3000

# Connexion PostgreSQL (le plus simple : une seule URL)
DATABASE_URL=postgresql://faithson:faithson@localhost:5432/faithson

# --- ou, à la place de DATABASE_URL, les variables séparées ---
# PGHOST=localhost
# PGPORT=5432
# PGUSER=faithson
# PGPASSWORD=faithson
# PGDATABASE=faithson

# Origine(s) autorisée(s) pour le front (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# Clé de protection des routes admin.
# - vide  => routes admin OUVERTES (pratique en développement)
# - définie => il faut envoyer l'en-tête  x-admin-key: <valeur>
ADMIN_API_KEY=

